+pub fn dbg_ctor_name() -> &'static str {
+    static V: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    V.get_or_init(|| std::env::var("PE_DBG_CTOR").unwrap_or_default()).as_str()
+}
