+// ---------------------------------------------------------------------------------------
+// Diagnostic instruments (poke_engine_doubles_instruments.patch). All OFF unless the matching
+// environment variable is set, and each reads it once, so an un-set build pays one atomic load
+// per call and prints nothing. Runs 15-17 each rebuilt these by hand; they live here now.
+//
+//   PE_DBG_BOOST_RANGE=1        report every boost write that leaves +-6 (runs 16, 17)
+//   PE_DBG_ITEM=1               report every item write with the body it lands on (run 15)
+//   PE_DBG_CTOR=<InstrName>     report every construction of that instruction WITH ITS SOURCE
+//                               SITE -- the mutator names the victim, only the constructor
+//                               names the culprit (runs 15, 16, 17)
+//
+// The PAIR is the method: mutator to prove a bad write exists, constructor to find who asked.
+// ---------------------------------------------------------------------------------------
+pub fn dbg_boost_range() -> bool {
+    static V: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *V.get_or_init(|| std::env::var("PE_DBG_BOOST_RANGE").is_ok())
+}
+pub fn dbg_item() -> bool {
+    static V: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *V.get_or_init(|| std::env::var("PE_DBG_ITEM").is_ok())
+}
