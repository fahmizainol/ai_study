+/// Renders a slotted instruction's active slot for Debug output: empty in a singles
+/// build (so singles output is unchanged byte for byte), `:<slot>` in a doubles build.
+/// Without this, `Damage SideTwo: 72` is ambiguous between the two actives, which makes
+/// doubles instruction lists unreadable and un-diffable.
+#[cfg(not(feature = "doubles"))]
+fn slot_tag(_slot: u8) -> String {
+    String::new()
+}
+#[cfg(feature = "doubles")]
+fn slot_tag(slot: u8) -> String {
+    format!(":{}", slot)
+}
