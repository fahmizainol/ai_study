+/// Whether the defender-facing modifiers and the accuracy gate must be resolved per
+/// target rather than once against the nominal target. True exactly when a spread move
+/// has more than one living target: each body carries its own abilities, items and type
+/// immunities, so a zero against one of them says nothing about the others. Always false
+/// in singles, where a move only ever has one target.
+#[cfg(feature = "doubles")]
+fn resolves_per_target(state: &State, attacking_side: &SideReference, choice: &Choice) -> bool {
+    choice.target.hits_multiple_targets()
+        && state.living_spread_target_count(*attacking_side, choice.target) > 1
+}
+
+#[cfg(not(feature = "doubles"))]
+fn resolves_per_target(_state: &State, _attacking_side: &SideReference, _choice: &Choice) -> bool {
+    false
+}
+
+/// Whether area protection on `pos`'s **own** side stops this move from hitting the body
+/// standing there. Wide Guard blocks spread moves; Quick Guard blocks increased-priority
+/// moves. Both are *side conditions*, so they protect the side that set them — including
+/// that side's own members against their partner's Earthquake — and they can never reach
+/// the other side. Keyed on `pos.side` for exactly that reason: a spread move blocked
+/// against one side must still hit the bodies standing on the other.
+///
+/// Matches Showdown's `wideguard.condition.onTryHit`, which fires per body on the guarded
+/// side and blocks only `allAdjacent`/`allAdjacentFoes`. `hits_multiple_targets()` is
+/// equivalent to that pair in this build: no move assigns `BothFoes` or `AllOthers` (the
+/// sole references to either are inside `hits_multiple_targets` itself). `flags.protect`
+/// stands in for `checkMoveBypassesProtect`, and is `true` for Earthquake, Surf and
+/// Heat Wave, so it narrows nothing that should be blocked.
+#[cfg(feature = "doubles")]
+fn area_protection_blocks(state: &State, choice: &Choice, pos: BattlePosition) -> bool {
+    if choice.category == MoveCategory::Status || !choice.flags.protect {
+        return false;
+    }
+    // Per-body protection volatiles. Protect and its variants shield the body carrying
+    // them and nobody else, so for a spread move they belong here, per position, exactly
+    // as the side conditions do. These are the same five the single-target path checks in
+    // `before_move` -- deliberately NOT `PROTECT_VOLATILES`, which also contains ENDURE,
+    // and Endure does not stop damage, it survives it at 1 HP.
+    let body = state
+        .get_side_immutable(&pos.side)
+        .get_active_slot_immutable(pos.slot);
+    for vs in [
+        PokemonVolatileStatus::PROTECT,
+        PokemonVolatileStatus::SPIKYSHIELD,
+        PokemonVolatileStatus::BANEFULBUNKER,
+        PokemonVolatileStatus::BURNINGBULWARK,
+        PokemonVolatileStatus::SILKTRAP,
+    ] {
+        if body.volatile_statuses.contains(&vs) {
+            return true;
+        }
+    }
+
+    let side_conditions = &state.get_side_immutable(&pos.side).side_conditions;
+    (choice.target.hits_multiple_targets() && side_conditions.wide_guard > 0)
+        || (choice.priority > 0 && side_conditions.quick_guard > 0)
+}
